            "temperature": 0.7,
            "top_p": 0.9
          }
        },
        "gpt-oss:20b": {
          "name": "GPT-OSS 20B",
          "params": {
            "num_ctx": 16384,
            "temperature": 0.1,
            "top_p": 0.9
          }
        },
        "llama3.2:3b": {
          "name": "LLaMA 3.2 3B",
          "params": {
            "num_ctx": 8192,
            "temperature": 0.7,
            "top_p": 0.9
          }
        }
      }
    }
  }
}
