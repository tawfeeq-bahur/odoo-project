{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.5:27b", 
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Server)",
      "options": {
        "baseURL": "http://localhost:49152/v1",
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "models": {
        "qwen3.5:27b": {
          "name": "Qwen 3.5 27B",
